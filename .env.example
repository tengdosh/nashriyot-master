# Nashriyot-Master — environment template. Copy to `.env` and fill in secrets.
# Infra (Postgres/Redis/AI service) runs via `docker compose up -d`.

# --- Database (Docker postgres:16 -> host port 5433; local 5432 is occupied) ---
DATABASE_URL="postgresql://nashriyot:nashriyot@localhost:5433/nashriyot?schema=public"

# --- Redis (Docker redis:7 -> host port 6380; local 6379 is occupied) ---
REDIS_URL="redis://localhost:6380"

# --- AI microservice (Docker ai-service -> host port 8001) ---
AI_SERVICE_URL="http://localhost:8001"
AI_SERVICE_TOKEN="change-me"

# --- Auth.js v5 (generate with `npx auth secret`) ---
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# --- Bot / read-only reports API ---
REPORTS_API_TOKEN="change-me"

# --- Demo seed (optional separate DB) ---
# DATABASE_URL_DEMO="postgresql://nashriyot:nashriyot@localhost:5433/nashriyot_demo?schema=public"
